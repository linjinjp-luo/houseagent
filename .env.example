# HouseAgent environment overrides. All are optional; safe defaults apply. Never put real credentials here.

# development | test | production (production hides API docs and detailed errors)
HOUSEAGENT_ENV=production
# User data folder (default: %LOCALAPPDATA%\HouseAgent)
# HOUSEAGENT_DATA_DIR=D:\HouseAgentData
# Preferred port; a free port is chosen automatically if it is busy
HOUSEAGENT_PORT=8765
# Browser engine for adapters: playwright (real browser) | http (mock site / tests)
HOUSEAGENT_BROWSER_ENGINE=playwright
# Playwright channel: msedge uses the Edge installed on Windows; chromium needs `playwright install chromium`
HOUSEAGENT_BROWSER_CHANNEL=msedge
# Seconds to wait for a page before PAGE_TIMEOUT
HOUSEAGENT_PAGE_TIMEOUT=30
# Serve the built-in mock property sites at /mock-site (V1.0 acceptance target)
HOUSEAGENT_MOCK_SITE=true
# Start the scheduler and run queue (tests switch this off)
HOUSEAGENT_BACKGROUND=true
# Folder containing portable python\ and node\ used by scripts\*.ps1 (default: ..\tools)
# HOUSEAGENT_TOOLS=D:\tools
# Optional AI: prefer storing the key in Settings (DPAPI-encrypted). Leave empty here.
# ANTHROPIC_API_KEY=
